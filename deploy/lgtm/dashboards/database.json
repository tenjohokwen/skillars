        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "sum(count_over_time({app=\"skillars\",level=~\"WARN|ERROR\"} |~ \"deadlock detected|40P01|DeadlockLoser\" [$__auto]))",
          "legendFormat": "Deadlock",
          "editorMode": "code",
          "queryType": "range",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "sum(count_over_time({app=\"skillars\",level=~\"WARN|ERROR\"} |~ \"55P03|could not obtain lock|CannotAcquireLock|PessimisticLockingFailure\" [$__auto]))",
          "legendFormat": "Lock timeout",
          "editorMode": "code",
          "queryType": "range",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "sum(count_over_time({app=\"skillars\",level=~\"WARN|ERROR\"} |~ \"OptimisticLock|ObjectOptimisticLocking|StaleObjectState\" [$__auto]))",
          "legendFormat": "Optimistic conflict",
          "editorMode": "code",
          "queryType": "range",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "sum(count_over_time({app=\"skillars\",level=~\"WARN|ERROR\"} |~ \"UnexpectedRollbackException|rollback-only\" [$__auto]))",
          "legendFormat": "Rollback-only",
          "editorMode": "code",
          "queryType": "range",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "sum(count_over_time({app=\"skillars\",level=~\"WARN|ERROR\"} |~ \"DataIntegrityViolation|violates (unique|foreign key|check) constraint\" [$__auto]))",
          "legendFormat": "Constraint violated",
          "editorMode": "code",
          "queryType": "range",
          "refId": "E"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "sum(count_over_time({app=\"skillars\",level=~\"WARN|ERROR\"} |~ \"QueryTimeoutException|statement timeout|57014\" [$__auto]))",
          "legendFormat": "Query timeout",
          "editorMode": "code",
          "queryType": "range",
          "refId": "F"
        }
      ],
