    {
      "type": "table",
      "title": "Slowest routes (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "topk(15, histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{uri!~\"/manage.*|.*/events\",uri!=\"UNKNOWN\"}[$__range]))) > 0)",
          "legendFormat": "__auto",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "filterable": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "p95"
            }
          }
        }
      ],
      "id": 3,
      "gridPos": {
