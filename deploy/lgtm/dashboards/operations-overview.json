        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "changes(process_start_time_seconds{application=\"skillars\"}[2m]) > 0",
        "titleFormat": "App restarted",
        "step": "60s"
      }
    ]
  },
  "description": "Start here: is the app up, are users getting errors, is anything waiting on a human.",
