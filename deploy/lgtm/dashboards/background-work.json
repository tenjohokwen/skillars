{
  "annotations": {
    "list": [
      {
        "name": "Restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "changes(process_start_time_seconds{application=\"skillars\"}[2m]) > 0",
        "titleFormat": "App restarted",
        "step": "60s"
      }
    ]
  },
  "description": "Scheduled jobs, outboxes, email, video and storage: the work no user is watching.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "skillars"
      ],
      "targetBlank": false,
      "title": "Skillars",
      "type": "dashboards"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "id": 2,
      "type": "row",
      "title": "Scheduled jobs",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "table",
      "title": "Jobs that failed",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (code_namespace, code_function, exception) (increase(tasks_scheduled_execution_seconds_count{outcome=\"FAILED\"}[$__range])) > 0",
          "legendFormat": "__auto",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "filterable": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "failures",
              "code_namespace": "class",
              "code_function": "job"
            }
          }
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "description": "Spring logs a failed @Scheduled run and tries again on the next tick, so without this a job can fail forever in silence."
    },
    {
      "type": "table",
      "title": "Longest run",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "topk(15, max by (code_namespace, code_function) (max_over_time(tasks_scheduled_execution_seconds_max[$__range])) > 0)",
          "legendFormat": "__auto",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "filterable": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "max",
              "code_namespace": "class",
              "code_function": "job"
            }
          }
        }
      ],
      "id": 4,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Job run time",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "topk(10, sum by (code_function) (rate(tasks_scheduled_execution_seconds_sum[$__rate_interval])))",
          "legendFormat": "{{code_function}}",
          "editorMode": "code",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "lastNotNull"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "description": "Seconds of job time per second. Above 1 means jobs overlap on the scheduler pool."
    },
