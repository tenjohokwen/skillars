{
  "annotations": {
    "list": [
      {
        "name": "Restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "changes(process_start_time_seconds{application=\"skillars\"}[2m]) > 0",
        "titleFormat": "App restarted",
        "step": "60s"
      }
    ]
  },
  "description": "State the money and booking flows left behind: what is stuck, who is waiting, and which integrity checks tripped.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "skillars"
      ],
      "targetBlank": false,
      "title": "Skillars",
      "type": "dashboards"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "id": 2,
      "type": "row",
      "title": "Work queues",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "table",
      "title": "Everything waiting, oldest first",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "max by (backlog, detail) (skillars_backlog_count)",
          "legendFormat": "count",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "max by (backlog, detail) (skillars_backlog_oldest_age_seconds)",
          "legendFormat": "age",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "oldest"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "detail",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "backlog 2": true,
              "Time": true
            },
            "renameByName": {
              "Value #A": "items",
              "Value #B": "oldest",
              "backlog 1": "backlog"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "oldest",
                "desc": true
              }
            ]
          }
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 11,
        "w": 14,
        "x": 0,
        "y": 1
      },
      "description": "skillars.backlog.* refreshes every minute from the database."
    },
