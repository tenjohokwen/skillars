{
  "name": "Bunny Stream — create a video (upload init). The guid is the provider asset id.",
  "priority": 10,
  "request": {
    "method": "POST",
    "urlPathPattern": "/bunny/library/[0-9]+/videos"
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "guid": "{{randomValue type='UUID'}}",
      "title": "{{jsonPath request.body '$.title'}}",
      "status": 0
    },
    "transformers": ["response-template"]
  }
}
