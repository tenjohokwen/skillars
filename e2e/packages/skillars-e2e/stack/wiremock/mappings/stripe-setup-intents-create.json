{
  "name": "Stripe — create SetupIntent (deterministic tier); the client secret ends with the customer id, so the Stripe.js stub and the provisioner can name a card that customer owns",
  "priority": 10,
  "request": {
    "method": "POST",
    "urlPath": "/v1/setup_intents"
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "id": "seti_e2e_{{randomValue length=14 type='ALPHANUMERIC'}}",
      "object": "setup_intent",
      "client_secret": "seti_e2e_{{randomValue length=14 type='ALPHANUMERIC'}}_secret_{{formData request.body 'form' urlDecode=true}}{{form.customer}}",
      "status": "requires_payment_method",
      "livemode": false
    }
  }
}
