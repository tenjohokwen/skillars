{
  "name": "Stripe — retrieve payment method (deterministic tier): a Visa ending 4242, owned by the customer its id encodes (deferred-174 ownership check)",
  "priority": 10,
  "request": {
    "method": "GET",
    "urlPathPattern": "/v1/payment_methods/pm_e2e_[A-Za-z0-9_]+"
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "id": "{{request.pathSegments.[2]}}",
      "object": "payment_method",
      "type": "card",
      "customer": "{{regexExtract request.pathSegments.[2] '^pm_e2e_(?:declined_)?([A-Za-z0-9]+)__' 'owner' default=''}}{{#if owner}}cus_e2e_{{owner.0}}{{/if}}",
      "livemode": false,
      "card": {
        "brand": "visa",
        "last4": "4242",
        "exp_month": 12,
        "exp_year": 2034,
        "fingerprint": "fp_{{request.pathSegments.[2]}}"
      }
    }
  }
}
