# ==============================================================
# Skillars — environment variable template
# ==============================================================
# This file is copied, never read directly. Nothing in the build or the deploy
# scripts loads it; it is the starting point for the three real env files:
#
#   production   cp .env.example .env        -> /opt/skillars/.env   (first-time-setup.md)
#   UAT          cp .env.example .env.uat                            (uat-deployment.md)
#   local        cp .env.example .env.local                          (local-deployment.md)
#
# Secure the production copy with: chmod 600 /opt/skillars/.env
# (deploy/provision.sh re-enforces mode 600 on every run)
#
# Create acme.json before first run:
#   touch /opt/skillars/traefik/acme.json && chmod 600 /opt/skillars/traefik/acme.json
#
# ONLY TWO KINDS OF VARIABLE BELONG IN HERE:
#   1. those interpolated as ${VAR} in a docker-compose*.yml, and
#   2. those the host-side scripts read after sourcing .env (deploy/backup/env-guard.sh)
# A variable that is hardcoded in compose cannot be changed from .env, so listing it
# here would only mislead. See docs/deployment/secrets-reference.md.
# ==============================================================

# --- Application Image ---
# GHCR image tag published by the CI/CD pipeline. ci.yml pushes to
# ghcr.io/${{ github.repository }}, i.e. ghcr.io/<github-owner>/skillars.
APP_IMAGE=ghcr.io/tenjohokwen/skillars:sha-abc1234

# --- Domain & TLS ---
# Production domain used by Traefik for routing and Let's Encrypt certificate
DOMAIN=api.example.com

# Email address for Let's Encrypt expiry notifications
LETSENCRYPT_EMAIL=admin@example.com

# --- PostgreSQL ---
POSTGRES_DB=skillars
POSTGRES_USER=skillars
# Generate a strong password: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-use-openssl-rand

# NOTE: SPRING_DATASOURCE_URL is deliberately absent. docker-compose.yml builds it from
# POSTGRES_DB directly, so a value set here would be ignored. Same for LOKI_URL,
# LOKI_ENABLED and MANAGEMENT_OTLP_TRACING_ENDPOINT — all three are hardcoded literals
# on the app service, not ${VAR} placeholders.

# --- Email / SMTP ---
# All four reach the app. Leaving SPRING_MAIL_PASSWORD blank is survivable (SMTP auth
# fails at send time); before 2026-09-02 an unset value aborted startup, because
# application.yaml references it with no default.
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=noreply@example.com
SPRING_MAIL_PASSWORD=change-me

# The notification module keeps its own provider list (email.providerConfigs in
# application.yaml) with one entry per provider, each taking its password from here.
# Same no-default rule as above.
GMX_PASSWORD=change-me
GMAIL_PASSWORD=change-me

# --- Bunny.net CDN (Video Storage) ---
BUNNY_API_KEY=change-me
BUNNY_LIBRARY_ID=123456
BUNNY_CDN_HOSTNAME=your-library.b-cdn.net

# --- LGTM Observability Stack ---
MONITORING_DOMAIN=monitoring.api.example.com
GF_SECURITY_ADMIN_USER=admin
# Generate with: openssl rand -base64 24
GF_SECURITY_ADMIN_PASSWORD=change-me-use-openssl-rand

# --- Grafana Alert Notifications ---
# SMTP server for Grafana to send email alerts (separate from Spring Boot's SPRING_MAIL_* vars)
# GF_SMTP_HOST format: hostname:port (e.g. smtp.gmail.com:587 for STARTTLS)
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.example.com:587
GF_SMTP_USER=alerts@example.com
# App password or SMTP credential (same provider as SPRING_MAIL_* if using the same server)
GF_SMTP_PASSWORD=change-me
GF_SMTP_FROM_ADDRESS=alerts@example.com
GF_SMTP_FROM_NAME=Skillars Alerts
# MandatoryStartTLS | OpportunisticStartTLS | NoStartTLS
GF_SMTP_STARTTLS_POLICY=MandatoryStartTLS
# Email address that receives all Grafana alerts (can be same as LETSENCRYPT_EMAIL)
GF_ALERT_NOTIFY_EMAIL=admin@example.com
# Slack incoming webhook URL for Grafana alert notifications
# Slack → Apps → Incoming Webhooks → Add to Slack → select #alerts channel → copy URL
GF_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# --- Backup: Hetzner Object Storage ---
# Hetzner Object Storage credentials (S3-compatible)
# Create a bucket in Hetzner Cloud Console → Object Storage
HOS_ACCESS_KEY=change-me
HOS_SECRET_KEY=change-me
# Bucket name (no protocol prefix)
HOS_BUCKET=skillars-backups
# Region endpoint — find in Hetzner Object Storage console (e.g. fsn1, nbg1, hel1)
HOS_ENDPOINT=https://s3.fsn1.hetzner.com
# Key prefix in the bucket — trailing slash required
HOS_BACKUP_PREFIX=pg-backups/
# Key prefix for file-level volume backups — trailing slash required
HOS_VOLUME_BACKUP_PREFIX=volume-backups/

# Retention tuning for deploy/backup/prune-backups.sh. Not secrets, and every one has a
# safe default in the script — listed here because they are the only way to change it.
# MIN_KEEP is the floor that stops a bad cutoff emptying the bucket.
BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_MIN_KEEP=8
VOLUME_BACKUP_RETENTION_DAYS=14
VOLUME_BACKUP_RETENTION_MIN_KEEP=4

# --- Stripe (REQUIRED — the app refuses to start without the API key) ---
# Dashboard -> Developers -> API keys. PaymentConfig rejects an sk_live_/rk_live_ key unless the
# "prod" profile is active, so a non-prod environment can never charge real money.
APP_PAYMENT_STRIPE_API_KEY=sk_test_change-me
# Dashboard -> Developers -> Webhooks -> your endpoint (path /api/payment/webhooks/stripe)
APP_PAYMENT_STRIPE_WEBHOOK_SECRET=whsec_change-me
# Dashboard -> Settings -> Connect -> Integration (coach Connect onboarding)
APP_PAYMENT_STRIPE_OAUTH_CLIENT_ID=ca_change-me
# Publishable key, served to the browser; card entry and pack purchase need it
APP_PAYMENT_STRIPE_PUBLISHABLE_KEY=pk_test_change-me
# MUST be absolute — Stripe rejects a relative redirect_uri
APP_PAYMENT_STRIPE_OAUTH_CALLBACK_URL=https://api.example.com/api/payment/coaches/me/stripe/callback

# --- Video signing secrets ---
# openssl rand -base64 32  (playback URL signing, HS256; needs >= 32 bytes decoded)
APP_VIDEO_PLAYBACK_SIGNING_SECRET=change-me
# Bunny.net Stream -> your library -> Webhook signing secret
APP_VIDEO_BUNNY_WEBHOOK_SIGNING_SECRET=change-me

# --- Object storage (uploads) ---
# Leave the two keys BLANK to use the AWS default credential chain (instance profile / ~/.aws).
# Set both only if you want static credentials.
APP_STORAGE_BUCKET=skillars-prod
APP_STORAGE_ENDPOINT_URL=https://s3.eu-west-1.amazonaws.com
APP_STORAGE_REGION=eu-west-1
APP_STORAGE_S3_ACCESS_KEY=
APP_STORAGE_S3_SECRET_KEY=

# --- Platform / AI ---
# openssl rand -base64 32 — encrypts parent-approval PINs.
# ROTATING THIS INVALIDATES EVERY PIN ALREADY STORED.
PLATFORM_PIN_ENCRYPTION_SECRET=change-me
# Google AI Studio -> API keys (AI narrative features)
GEMINI_API_KEY=
# Stamped on every log line and Loki stream; set APP_VERSION from CI to correlate across deploys
ENVIRONMENT=prod
APP_VERSION=unknown
# Base URL used to build email verification links — a wrong value sends users unusable links
APP_FRONTEND_URL=https://skillars.com
# Tomcat access logging via SLF4J -> Loki. false disables both the 9990 and 8367 loggers.
APP_ACCESS_LOG_ENABLED=true

# --- UAT only (docker-compose.uat.yml) ---
# Ignored by a production deploy — docker-compose.yml has no MinIO service and routes
# storage at real S3. Present because .env.uat is copied from this same file.
# MinIO stands in for S3 in UAT; STORAGE_DOMAIN is the public hostname Traefik routes to
# it, which must be reachable BY THE BROWSER because presigned upload URLs are built from it.
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-use-openssl-rand
STORAGE_DOMAIN=storage.uat.example.com
# Actuator's mail health indicator opens a real SMTP connection and authenticates; set
# false wherever the mail credentials above are placeholders, or /manage/health reports
# DOWN and the container never becomes healthy.
MANAGEMENT_HEALTH_MAIL_ENABLED=true

# --- First-admin bootstrap (UAT / initial setup) ---
# BLANK MEANS DISABLED. AdminBootstrapRunner creates the platform's first ROLE_ADMIN account at
# startup, once, and only when EMAIL and PASSWORD are both non-blank. No migration seeds an admin
# user and there is no admin registration endpoint, so this is the only supported way to get one.
# PHONE is required whenever the other two are set (main."user".phone is UNIQUE — no shared
# placeholder is safe). Remove APP_BOOTSTRAP_ADMIN_PASSWORD and redeploy once the account exists.
# See docs/deployment/uat-deployment.md Step 8.
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_PHONE=
