					<version>2.28.29</version>
					<type>pom</type>
					<scope>import</scope>
				</dependency>

				<!--
				  Transitive security pins. Neither of these is exposed as a Boot property, so
				  they are pinned here rather than in <properties>. Both arrive through a
				  dependency we do not control the version of; drop the pin once that upstream
				  ships the fixed version itself.

				  bcprov  CVE-2025-14813 (CRITICAL). Arrives at 1.80 via
				          spring-cloud-commons 4.3.1 (spring-cloud-starter). Fix: 1.81.1.
				  beanutils CVE-2025-48734. Arrives at 1.9.4 via commons-validator 1.9.0.
				          Fix: 1.11.0.
				-->
				<dependency>
					<groupId>org.bouncycastle</groupId>
					<artifactId>bcprov-jdk18on</artifactId>
					<version>1.81.1</version>
				</dependency>
				<dependency>
					<groupId>commons-beanutils</groupId>
					<artifactId>commons-beanutils</artifactId>
					<version>1.11.0</version>
				</dependency>
			</dependencies>
		</dependencyManagement>
	
