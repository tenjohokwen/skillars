			<node.version>v22.16.0</node.version>
			<spring-cloud.version>2025.1.2</spring-cloud.version>
			<!--
			  Backend-only iteration switch: `mvn -o verify -DskipFrontend` skips all five
			  frontend-maven-plugin executions (install-node-and-npm, npm install,
			  npm install -g @quasar/cli, npm test, npx quasar build).

			  WARNING: this changes the packaged artifact. maven-resources-plugin copies
			  src/frontend/dist/spa -> target/classes/static at process-resources; on a clean
			  tree with this flag that directory does not exist, so the resulting jar ships
			  with NO UI. Fine for backend iteration, unacceptable for anything deployed.
			  MUST NOT be set in any CI workflow; pr-build.yml builds a Docker image from
			  this same artifact. See docs/testing/readme.md.
			-->
			<skipFrontend>false</skipFrontend>

			<!--
			  Security overrides of the Boot parent's managed versions. Trivy fails the
			  pr-build scan on CRITICAL/HIGH findings; these are the ones with a fix available.
			  Remove an override once the Boot parent's own managed version reaches or exceeds it.

			  Most of what Trivy flagged on 3.5.11 is now carried by the 3.5.16 parent itself
			  and needs no override here: tomcat 10.1.55, spring-framework 6.2.19,
			  spring-security 6.5.11, jackson 2.21.4, micrometer 1.15.12, spring-data 2025.0.13.

			  thymeleaf  CVE-2026-41901 / CVE-2026-40478 - server-side template injection.
			             Trivy reports the fix as 3.1.5.RELEASE. Thymeleaf is genuinely used
			             here (the registration/notification email templates), so this is a
			             reachable code path, not a dormant dependency.
			  netty      CVE-2026-59901 (netty-codec), CVE-2026-55831/55833/56745
			             (netty-codec-http), CVE-2026-56819 (http2), CVE-2026-44249/45416/50010
			             (netty-handler). Fix on the 4.1.x line is 4.1.136.Final.
			  postgresql CVE-2026-42198, CVE-2026-54291. The 3.5.16 parent manages 42.7.11,
			             which fixes only the first; 42.7.12 fixes both.
			-->
			<thymeleaf.version>3.1.5.RELEASE</thymeleaf.version>
			<netty.version>4.1.136.Final</netty.version>
			<postgresql.version>42.7.12</postgresql.version>
		</properties>
	
