							<goal>npx</goal>
						</goals>
						<phase>generate-resources</phase>
						<configuration>
							<arguments>quasar build</arguments>
						</configuration>
					</execution>
				</executions>
				<configuration>
					<nodeVersion>${node.version}</nodeVersion>
					<workingDirectory>src/frontend</workingDirectory>
					<!-- Plugin-level config merges into every execution above; none of the
					     five overrides <skip>, so -DskipFrontend disables all of them. -->
					<skip>${skipFrontend}</skip>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<executions>
					<execution>
						<id>Copy Vue frontend into Spring Boot target static folder</id>
						<phase>process-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>target/classes/static</outputDirectory>
							<nonFilteredFileExtensions>
								<!-- Exclude files with non-utf-8 content that will cause errors on filtering -->
								<nonFilteredFileExtension>ttf</nonFilteredFileExtension>
								<nonFilteredFileExtension>eot</nonFilteredFileExtension>
								<nonFilteredFileExtension>woff</nonFilteredFileExtension>
								<nonFilteredFileExtension>woff2</nonFilteredFileExtension>
							</nonFilteredFileExtensions>
							<resources>
								<resource>
									<directory>src/frontend/dist/spa</directory>
									<filtering>true</filtering>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<trimStackTrace>false</trimStackTrace>
					<!--
					  All ~135 IT classes share ONE forked JVM (no forkCount/reuseForks here), and the
					  Spring TestContext cache holds every context open for the whole run: ~26 contexts
					  against the default cache.maxSize of 32 means nothing is ever evicted, so nothing
					  is ever closed. A thread dump taken mid-run measured 427 live threads — 12
					  Tomcats, 6 Quartz schedulers, 7 Hikari pools, 10+ WireMock Jetty servers, all
					  alive simultaneously.

					  That fork has intermittently died mid-suite, surfacing as
					  "SurefireBooterForkException: There was an error in the forked process / Unable to
					  create test class '<whichever class was loading at the time>'" — a severed pipe
					  naming an innocent class, with no indication of the cause. The flags below exist
					  to make the NEXT occurrence legible; they are not meant to change how the suite
					  runs.

					  -Xmx4g pins what the JVM already chooses ergonomically on a 16 GB host (1/4 of
					  RAM), so the limit stops varying with the machine. Deliberately NOT lower: the
					  suite passes at 4g today.

					  ExitOnOutOfMemoryError turns a silent fork death into an unambiguous exit;
					  HeapDumpOnOutOfMemoryError names whatever is being retained.

					  The GC log is pure observation with no limit attached, and records actual heap and
					  metaspace across the run. Metaspace is deliberately left UNCAPPED — capping it
					  could only invent a new failure mode on a build that is currently green. Cap it
					  once this log shows what it genuinely uses.
					-->
					<argLine>-Duser.timezone=UTC -Xmx4g -XX:+ExitOnOutOfMemoryError -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=${project.build.directory}/failsafe-heapdump.hprof -Xlog:gc+heap=info,gc+metaspace=info:file=${project.build.directory}/failsafe-gc.log:time,uptime:filecount=3,filesize=20M</argLine>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<trimStackTrace>false</trimStackTrace>
					<argLine>-Duser.timezone=UTC</argLine>
				</configuration>
			</plugin>
			<plugin>
				<groupId>io.github.git-commit-id</groupId>
				<artifactId>git-commit-id-maven-plugin</artifactId>
				<version>9.1.0</version>
				<executions>
					<execution>
						<id>get-the-git-infos</id>
						<goals>
							<goal>revision</goal>
						</goals>
						<phase>initialize</phase>
					</execution>
				</executions>
				<configuration>
					<generateGitPropertiesFile>true</generateGitPropertiesFile>
					<generateGitPropertiesFilename>${project.build.outputDirectory}/git.properties</generateGitPropertiesFilename>
					<commitIdGenerationMode>full</commitIdGenerationMode>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>mutation</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-maven</artifactId>
						<version>1.25.9</version>
						<dependencies>
							<dependency>
								<groupId>org.pitest</groupId>
								<artifactId>pitest-junit5-plugin</artifactId>
								<version>1.2.3</version>
							</dependency>
						</dependencies>
						<configuration>
							<!--
							  PITest can mutate domain classes without starting a Spring context.
							-->
							<targetClasses>
								<!-- Add domain classes for mutation testing here -->
							</targetClasses>
							<targetTests>
								<!-- Add domain tests here -->
							</targetTests>
							<mutators>
								<mutator>STRONGER</mutator>
							</mutators>
							<mutationThreshold>90</mutationThreshold>
							<timeoutConstant>10000</timeoutConstant>
							<threads>2</threads>
							<useClasspathJar>true</useClasspathJar>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
