diff --git a/src/main/resources/db/migration/V128__platform_config_identity.sql b/src/main/resources/db/migration/V128__platform_config_identity.sql
new file mode 100644
index 0000000..0f160ad
--- /dev/null
+++ b/src/main/resources/db/migration/V128__platform_config_identity.sql
@@ -0,0 +1,44 @@
+-- skillars-deferred-92 AC10: give main.platform_config.id an identity, so seed migrations stop
+-- hand-picking the next free primary key.
+--
+-- V20 created the table with `id BIGINT NOT NULL, PRIMARY KEY (id)` and no sequence, so every
+-- migration that seeds a config row has had to guess the next free id by reading the ones before it.
+-- V99's own header spends six lines on why that is dangerous, and the mechanism is worth restating
+-- because it is not the obvious one: the seeds use `ON CONFLICT (key)`, which targets the UNIQUE
+-- constraint on `key` — a DIFFERENT constraint from the primary key. So an id collision raises a
+-- PRIMARY KEY violation that the ON CONFLICT clause never sees, and Flyway fails on every database
+-- that has already run a later migration using that id. The ledger records five separate brushes
+-- with this (V25 112-114, V33 id=39, V46 70-72, V48, V53 117-132).
+--
+-- BY DEFAULT, not ALWAYS. This is the load-bearing choice in the migration.
+--   * GENERATED ALWAYS rejects any INSERT that supplies an explicit id. Every historical seed
+--     (V20, V25, V33, V46, V48, V53, V93, V99 ...) does exactly that, and Flyway replays all of them
+--     from scratch on a fresh database. ALWAYS would therefore break CI and every new environment
+--     while continuing to look fine on already-migrated ones — the worst possible failure shape.
+--   * GENERATED BY DEFAULT leaves the historical inserts working and supplies a value only when one
+--     is omitted, which is what new seeds will do.
+--
+-- The sequence is seeded from the live maximum, computed here rather than hardcoded: hardcoding it
+-- would reintroduce the same "guess the next free number" problem this migration exists to remove.
+-- COALESCE covers the empty-table case (setval requires a value >= 1 with is_called = false).
+--
+-- MigrationLint.Rule.PLATFORM_CONFIG_EXPLICIT_ID now fails the build on any future
+-- `INSERT INTO main.platform_config (id, ...)`, so the old pattern cannot come back.
+
+-- ACCESS EXCLUSIVE on main.platform_config for the duration of the ALTER. The table is a small
+-- configuration table (~130 rows) and the operation is catalog-only, so the statement itself is
+-- instantaneous — but a bounded wait is still required (skillars-deferred-92 AC8): without it, an
+-- ALTER blocked behind a long-running reader makes every subsequent query on the table queue behind
+-- the ALTER, and ConfigService reads this table on a 5-minute refresh from every node.
+SET lock_timeout = '5s';
+
+ALTER TABLE main.platform_config
+    ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY;
+
+-- Start above every id the historical seeds have already claimed. pg_get_serial_sequence resolves
+-- the sequence the identity just created, so the name is never hardcoded either.
+SELECT setval(
+    pg_get_serial_sequence('main.platform_config', 'id'),
+    (SELECT COALESCE(max(id), 1) FROM main.platform_config),
+    true
+);
diff --git a/src/main/resources/db/migration/V129__reset_never_sent_secondary_reminders.sql b/src/main/resources/db/migration/V129__reset_never_sent_secondary_reminders.sql
new file mode 100644
index 0000000..3d65305
--- /dev/null
+++ b/src/main/resources/db/migration/V129__reset_never_sent_secondary_reminders.sql
@@ -0,0 +1,35 @@
+-- skillars-deferred-92 AC29.5: un-stamp the 2-hour reminders that were recorded as sent but never were.
+--
+-- Until AC29, BookingEmailListener.onBookingReminder carried no annotation at all — not
+-- @EventListener, not @TransactionalEventListener — so Spring never dispatched
+-- BookingReminderEvent to it and EmailTemplate.BOOKING_REMINDER had no other sender anywhere in
+-- src/main. No booking reminder has ever been delivered. BookingReminderScheduler nonetheless
+-- stamped both *_reminder_sent_at columns inside its own transaction, so the database records
+-- sends that did not happen.
+--
+-- Why only the SECONDARY column is reset:
+--   * BookingRepository.findUpcomingWithin2hWindow filters `secondary_reminder_sent_at IS NULL`, so
+--     a stamped row is permanently excluded. Without this reset, every booking already stamped when
+--     the fix deploys would silently never get its 2-hour reminder either — the bug would outlive
+--     its own fix for exactly the bookings closest to starting.
+--   * primary_reminder_sent_at gates nothing. findConfirmedForUpcomingTransition selects on
+--     status = 'CONFIRMED' and the transition moves the row to 'UPCOMING', so the primary reminder
+--     is already once-only by state, not by stamp. Clearing it would change no behaviour and would
+--     destroy the only record of which bookings were affected.
+--
+-- Bounded and idempotent by construction: only rows still in the future and still UPCOMING are
+-- touched. Past bookings keep their (inaccurate) stamp — re-reminding someone about a session that
+-- has already happened is worse than the missing reminder. Worst case for an affected row is one
+-- reminder arriving slightly late; there is no double-send, because nothing was sent.
+--
+-- Row count is tiny by nature (the secondary window is 2 hours wide) and this project has no
+-- production deployment yet, so a single bounded UPDATE is correct here — no chunking needed. See
+-- docs/deployment/migration-conventions.md § "Full-table DML" for when chunking IS required.
+--
+-- Lock profile: UPDATE takes ROW EXCLUSIVE, which does not block concurrent readers or writers of
+-- other rows, so no SET lock_timeout is required (that convention binds lock-taking DDL).
+UPDATE booking.bookings
+   SET secondary_reminder_sent_at = NULL
+ WHERE secondary_reminder_sent_at IS NOT NULL
+   AND status = 'UPCOMING'
+   AND requested_start_time > NOW();
